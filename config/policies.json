{
  "version": "robinhood-observe-v2",
  "chain": "robinhood",
  "chainId": 4663,
  "environment": "mainnet",
  "mode": "observe",
  "data": {
    "maxFutureSkewSeconds": 30,
    "maxAgeSeconds": { "chainState": 60, "security": 600, "holders": 300, "market": 120, "activity": 120, "liquidityProtection": 600, "quote": 60 },
    "maxHeadAgeSeconds": 60,
    "allowedQuoteAssets": ["WETH", "USDG"],
    "allowedTokenStandards": ["erc20"],
    "allowedLiquidityMechanisms": ["burned", "locked"],
    "probeAmountUsd": 100
  },
  "securityGates": [
    { "metric": "chainState.sequencerHealthy", "op": "eq", "value": true, "reason": "Sequenciador indisponível ou degradado" },
    { "metric": "chainState.reorgDetected", "op": "eq", "value": false, "reason": "Reorganização detetada no universo analisado" },
    { "metric": "security.hasBytecode", "op": "eq", "value": true, "reason": "Endereço sem bytecode de contrato" },
    { "metric": "security.contractVerified", "op": "eq", "value": true, "reason": "Código e implementação não verificados" },
    { "metric": "security.canMint", "op": "eq", "value": false, "reason": "Possibilidade de emissão adicional" },
    { "metric": "security.canPause", "op": "eq", "value": false, "reason": "Possibilidade de pausar transferências" },
    { "metric": "security.canBlacklist", "op": "eq", "value": false, "reason": "Possibilidade de bloquear carteiras" },
    { "metric": "security.whitelistOnly", "op": "eq", "value": false, "reason": "Negociação restrita a whitelist" },
    { "metric": "security.canChangeFees", "op": "eq", "value": false, "reason": "Taxas do token alteráveis" },
    { "metric": "security.canConfiscate", "op": "eq", "value": false, "reason": "Possibilidade de confiscar ou alterar saldos" },
    { "metric": "security.proxyUpgradeable", "op": "eq", "value": false, "reason": "Contrato ou implementação atualizável" },
    { "metric": "security.hiddenPrivileges", "op": "eq", "value": false, "reason": "Privilégios ocultos ou administradores indiretos" },
    { "metric": "security.untrustedTransferCalls", "op": "eq", "value": false, "reason": "Transferências dependentes de chamadas externas não verificadas" },
    { "metric": "security.honeypotDetected", "op": "eq", "value": false, "reason": "Comportamento de honeypot detetado" },
    { "metric": "market.dexVerified", "op": "eq", "value": true, "reason": "DEX, factory, router ou pool não verificados" },
    { "metric": "market.hasUnreviewedHooks", "op": "eq", "value": false, "reason": "Hooks de pool não analisados" },
    { "metric": "security.mutableTransferRules", "op": "eq", "value": false, "reason": "Regras de transferência alteráveis" },
    { "metric": "security.knownMalicious", "op": "eq", "value": false, "reason": "Evidência de atividade maliciosa" },
    { "metric": "security.liquidityRemovableByCreator", "op": "eq", "value": false, "reason": "Liquidez removível pelo criador" },
    { "metric": "security.buyTaxPct", "op": "lte", "value": 0, "reason": "Taxa adicional de compra" },
    { "metric": "security.sellTaxPct", "op": "lte", "value": 0, "reason": "Taxa adicional de venda" },
    { "metric": "security.suspiciousVolumePct", "op": "lte", "value": 20, "reason": "Volume suspeito acima do limite" },
    { "metric": "liquidityProtection.verified", "op": "eq", "value": true, "reason": "Proteção de liquidez não verificada on-chain" },
    { "metric": "liquidityProtection.coveragePct", "op": "gte", "value": 95, "reason": "Menos de 95% da liquidez protegida" },
    { "metric": "quote.buySucceeded", "op": "eq", "value": true, "reason": "Simulação de compra falhou" },
    { "metric": "quote.sellSucceeded", "op": "eq", "value": true, "reason": "Simulação de venda falhou" },
    { "metric": "quote.buyImpactPct", "op": "lte", "value": 2, "reason": "Impacto de compra excessivo" },
    { "metric": "quote.sellImpactPct", "op": "lte", "value": 2, "reason": "Impacto de venda excessivo" },
    { "metric": "quote.roundTripLossPct", "op": "lte", "value": 8, "reason": "Perda simulada de ida e volta excessiva" }
  ],
  "pipelines": {
    "new": {
      "label": "Novos lançamentos",
      "ageMinMinutes": 15,
      "ageMaxMinutes": 2880,
      "pollSeconds": 60,
      "confirmation": { "minObservations": 3, "minSpanSeconds": 120, "maxGapSeconds": 180 },
      "minScore": 75,
      "securityGates": [
        { "metric": "holders.top1Pct", "op": "lte", "value": 5, "reason": "Maior carteira acima de 5%" },
        { "metric": "holders.top10Pct", "op": "lte", "value": 25, "reason": "Top 10 acima de 25%" },
        { "metric": "holders.deployerPct", "op": "lte", "value": 2, "reason": "Criador acima de 2%" },
        { "metric": "holders.linkedInsidersPct", "op": "lte", "value": 10, "reason": "Insiders ligados acima de 10%" },
        { "metric": "holders.bundledSupplyPct", "op": "lte", "value": 10, "reason": "Supply em bundles acima de 10%" },
        { "metric": "lockRemainingDays", "op": "gte", "value": 7, "reason": "Liquidez bloqueada por menos de 7 dias" },
        { "metric": "market.liquidityChange5mPct", "op": "gte", "value": -10, "reason": "Queda de liquidez superior a 10% em 5m" }
      ],
      "eligibilityGates": [
        { "metric": "market.liquidityUsd", "op": "gte", "value": 50000, "reason": "Liquidez abaixo de US$50 mil" },
        { "metric": "market.fdvUsd", "op": "gte", "value": 100000, "reason": "FDV abaixo de US$100 mil" },
        { "metric": "market.fdvUsd", "op": "lte", "value": 10000000, "reason": "FDV acima de US$10 milhões" },
        { "metric": "fdvLiquidityRatio", "op": "lte", "value": 80, "reason": "FDV/liquidez acima de 80" },
        { "metric": "holders.count", "op": "gte", "value": 200, "reason": "Menos de 200 holders" },
        { "metric": "activity.volume5mUsd", "op": "gte", "value": 5000, "reason": "Volume de 5m abaixo de US$5 mil" },
        { "metric": "activity.uniqueTraders5m", "op": "gte", "value": 30, "reason": "Menos de 30 traders únicos em 5m" },
        { "metric": "activity.organicTraderPct", "op": "gte", "value": 70, "reason": "Participação orgânica abaixo de 70%" },
        { "metric": "activity.holderGrowth5mPct", "op": "gte", "value": 1, "reason": "Crescimento de holders abaixo de 1% em 5m" },
        { "metric": "volumeAcceleration5m", "op": "gte", "value": 1.2, "reason": "Aceleração do volume de 5m abaixo de 1,2x" },
        { "metric": "netBuy5mLiquidityPct", "op": "gte", "value": 1, "reason": "Fluxo líquido comprador de 5m abaixo de 1% da liquidez" },
        { "metric": "volume5mLiquidityRatio", "op": "lte", "value": 3, "reason": "Rotação em 5m acima de 3x a liquidez" },
        { "metric": "market.priceChange5mPct", "op": "gte", "value": -5, "reason": "Preço a cair mais de 5% em 5m" },
        { "metric": "market.priceChange5mPct", "op": "lte", "value": 20, "reason": "Preço já subiu mais de 20% em 5m" }
      ],
      "score": [
        { "metric": "market.liquidityUsd", "weight": 15, "floor": 50000, "target": 250000 },
        { "metric": "activity.holderGrowth5mPct", "weight": 20, "floor": 1, "target": 8 },
        { "metric": "activity.uniqueTraders5m", "weight": 20, "floor": 30, "target": 200 },
        { "metric": "volumeAcceleration5m", "weight": 15, "floor": 1.2, "target": 3 },
        { "metric": "netBuy5mLiquidityPct", "weight": 20, "floor": 1, "target": 8 },
        { "metric": "market.priceChange5mPct", "weight": 10, "floor": 0, "target": 10 }
      ]
    },
    "established": {
      "label": "Tokens estabelecidos",
      "ageMinMinutes": 10080,
      "ageMaxMinutes": null,
      "pollSeconds": 300,
      "confirmation": { "minObservations": 2, "minSpanSeconds": 900, "maxGapSeconds": 660 },
      "minScore": 75,
      "securityGates": [
        { "metric": "holders.top1Pct", "op": "lte", "value": 8, "reason": "Maior carteira acima de 8%" },
        { "metric": "holders.top10Pct", "op": "lte", "value": 35, "reason": "Top 10 acima de 35%" },
        { "metric": "holders.deployerPct", "op": "lte", "value": 3, "reason": "Criador acima de 3%" },
        { "metric": "holders.linkedInsidersPct", "op": "lte", "value": 15, "reason": "Insiders ligados acima de 15%" },
        { "metric": "holders.bundledSupplyPct", "op": "lte", "value": 15, "reason": "Supply em bundles acima de 15%" },
        { "metric": "lockRemainingDays", "op": "gte", "value": 30, "reason": "Liquidez bloqueada por menos de 30 dias" },
        { "metric": "market.liquidityChange1hPct", "op": "gte", "value": -10, "reason": "Queda de liquidez superior a 10% em 1h" }
      ],
      "eligibilityGates": [
        { "metric": "poolAgeMinutes", "op": "gte", "value": 1440, "reason": "Pool com menos de 24h" },
        { "metric": "market.liquidityUsd", "op": "gte", "value": 150000, "reason": "Liquidez abaixo de US$150 mil" },
        { "metric": "market.fdvUsd", "op": "gte", "value": 500000, "reason": "FDV abaixo de US$500 mil" },
        { "metric": "market.fdvUsd", "op": "lte", "value": 100000000, "reason": "FDV acima de US$100 milhões" },
        { "metric": "fdvLiquidityRatio", "op": "lte", "value": 100, "reason": "FDV/liquidez acima de 100" },
        { "metric": "holders.count", "op": "gte", "value": 1000, "reason": "Menos de 1000 holders" },
        { "metric": "activity.volume24hUsd", "op": "gte", "value": 100000, "reason": "Volume de 24h abaixo de US$100 mil" },
        { "metric": "activity.uniqueTraders1h", "op": "gte", "value": 150, "reason": "Menos de 150 traders únicos em 1h" },
        { "metric": "activity.organicTraderPct", "op": "gte", "value": 75, "reason": "Participação orgânica abaixo de 75%" },
        { "metric": "activity.holderGrowth24hPct", "op": "gte", "value": 3, "reason": "Crescimento de holders abaixo de 3% em 24h" },
        { "metric": "volumeAcceleration1h", "op": "gte", "value": 1.5, "reason": "Volume de 1h abaixo de 1,5x a média das 23h anteriores" },
        { "metric": "netBuy1hLiquidityPct", "op": "gte", "value": 2, "reason": "Fluxo líquido comprador de 1h abaixo de 2% da liquidez" },
        { "metric": "volume1hLiquidityRatio", "op": "lte", "value": 5, "reason": "Rotação de 1h acima de 5x a liquidez" },
        { "metric": "market.priceChange1hPct", "op": "gte", "value": -5, "reason": "Preço a cair mais de 5% em 1h" },
        { "metric": "market.priceChange1hPct", "op": "lte", "value": 25, "reason": "Preço já subiu mais de 25% em 1h" },
        { "metric": "market.priceChange24hPct", "op": "gte", "value": -15, "reason": "Preço a cair mais de 15% em 24h" },
        { "metric": "market.priceChange24hPct", "op": "lte", "value": 60, "reason": "Preço já subiu mais de 60% em 24h" },
        { "metric": "market.distanceToVwap1hPct", "op": "gte", "value": -3, "reason": "Preço mais de 3% abaixo do VWAP de 1h" },
        { "metric": "market.distanceToVwap1hPct", "op": "lte", "value": 12, "reason": "Preço mais de 12% acima do VWAP de 1h" },
        { "metric": "market.drawdownFrom7dHighPct", "op": "lte", "value": 70, "reason": "Queda superior a 70% face ao máximo de 7 dias" }
      ],
      "score": [
        { "metric": "market.liquidityUsd", "weight": 20, "floor": 150000, "target": 1000000 },
        { "metric": "activity.holderGrowth24hPct", "weight": 20, "floor": 3, "target": 15 },
        { "metric": "activity.uniqueTraders1h", "weight": 15, "floor": 150, "target": 1000 },
        { "metric": "volumeAcceleration1h", "weight": 20, "floor": 1.5, "target": 4 },
        { "metric": "netBuy1hLiquidityPct", "weight": 15, "floor": 2, "target": 12 },
        { "metric": "market.priceChange1hPct", "weight": 10, "floor": 0, "target": 15 }
      ]
    }
  }
}
