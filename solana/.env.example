# Server-side only; no credentials/private keys required. Mainnet is verified by genesis hash.
SOLANA_RPC_HTTP_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_WS_URL=wss://api.mainnet-beta.solana.com
SOLANA_PROGRAMS=pump_fun,pump_swap,raydium_launchlab,raydium_cpmm
SOLANA_COMMITMENT=confirmed
SOLANA_RPC_REQUESTS_PER_MINUTE=60
SOLANA_RPC_CONCURRENCY=2
SOLANA_QUEUE_CAPACITY=1000
SOLANA_QUEUE_CONCURRENCY=2
SOLANA_MAX_DURABLE_BACKLOG=250
SOLANA_INGRESS_CAPACITY=1000
SOLANA_RECOVERY_BACKLOG_THRESHOLD=20
SOLANA_RECOVERY_PAGE_SIZE=100
SOLANA_RECOVERY_MAX_PAGES=5
SOLANA_RECONNECT_MAX_MS=30000
SOLANA_WS_IDLE_TIMEOUT_MS=60000
SOLANA_DB_PATH=runtime/solana/scanner.sqlite
SOLANA_RETENTION_DAYS=7
SOLANA_RAW_RETENTION_HOURS=24
SOLANA_MAX_STORAGE_BYTES=536870912
SOLANA_SECURITY_ENABLED=false
SOLANA_HEALTH_HOST=127.0.0.1
SOLANA_HEALTH_PORT=8787
# Optional live soak; normal start runs until SIGTERM/SIGINT.
SOLANA_SOAK_SECONDS=3600
# Publish binary RPC log observations separately from enriched /events.
SOLANA_LOG_OBSERVATIONS_ENABLED=true
SOLANA_MAX_OBSERVATION_ROWS=25000
# Use a distinct report directory for concurrent assays with independent DBs.
SOLANA_REPORT_DIR=runtime
